'use strict';
const { parentPort, workerData } = require('worker_threads');
const { pickMove, analyse } = require('./engine');

try {
    if (Array.isArray(workerData.fens)) {
        // وضع التحليل: تقييم قائمة مراكز
        const out = workerData.fens.map((fen) => {
            try { return analyse(fen, workerData.depth || 3, workerData.timeMs || 400); } catch (e) { return null; }
        });
        parentPort.postMessage({ evals: out });
    } else {
        parentPort.postMessage({ move: pickMove(workerData.fen, workerData.level, workerData.timeMs) });
    }
} catch (e) {
    parentPort.postMessage({ move: null, evals: null, error: String(e && e.message) });
}
